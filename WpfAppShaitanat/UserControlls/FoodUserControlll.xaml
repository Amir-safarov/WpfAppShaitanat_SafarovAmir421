<UserControl x:Class="WpfAppShaitanat.UserControlls.FoodUserControlll"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfAppShaitanat.UserControlls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderBrush = "Black" BorderThickness="1" Margin="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width = "1*" />
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Button Name="EditImageBtn" BorderBrush="Black" BorderThickness="1">    
                <Image Name = "FoodImg"/>
            </Button>
            <StackPanel Grid.Column="1" HorizontalAlignment= "Left" VerticalAlignment= "Center">
                <StackPanel HorizontalAlignment="Right" Margin="5">
                    <TextBlock Text="Наименование: "/>
                    <TextBox Name= "FoodNameTB" Width="150" LostFocus="FoodNameTB_LostFocus"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Margin="5">
                    <TextBlock Text="Цена: "/>
                    <TextBox Name= "FoodPriceTB"  Width="150" LostFocus ="FoodPriceTB_LostFocus" PreviewTextInput="FoodPriceTb_PreviewTextInput"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Left" Margin="5">
                    <TextBlock Text="Последнее изменение: "/>
                    <TextBlock Name= "FoodLastEditDateTB"/>
                </StackPanel>
            </StackPanel >
        </Grid>
    </Border>
</UserControl>
