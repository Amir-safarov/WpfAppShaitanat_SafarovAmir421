<Window x:Class="WpfAppShaitanat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppShaitanat"
        mc:Ignorable="d"
        Title="Шайтанэт" Height="650" Width="1000" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height = "1*" />
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <DockPanel VerticalAlignment="Center">
            <TextBlock Text="Шайтанэт" HorizontalAlignment="Left"  VerticalAlignment="Center" Margin="5"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Name = "CloseButton"  Click="CloseButton_Click" Content ="Свернуть" Margin="5" Height="30" Width="120" FontWeight="Bold"/>
                <Button Name = "AppExitButton" Click="AppExitButton_Click" Content="Закрыть" Margin="5" Height="30" Width="120" FontWeight="Bold"/>
            </StackPanel>
        </DockPanel>
        <Frame Name = "MainFrame" NavigationUIVisibility="Hidden" Grid.Row="1"/>
    </Grid>
</Window>
