<Page x:Class="WpfAppShaitanat.Pages.AddNewFoodPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppShaitanat.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddNewFoodPage">

    <Grid>
        <StackPanel VerticalAlignment = "Center" HorizontalAlignment="Center">
            <StackPanel Orientation = "Horizontal" HorizontalAlignment="Right" Margin="3">
                <TextBlock Text = "Фото :" VerticalAlignment="Center"/>
                <Button Name = "EditImaeButton" Click="EditImaeButton_Click" Width="70" Height="70">
                    <Image Name = "tImage" ></Image>
                </Button >
            </StackPanel >
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="3">
                <TextBlock Text = "Наименование:" />
                <TextBox Name="FoodNameTB" Width="200"></TextBox>
            </StackPanel>
            <StackPanel Orientation = "Horizontal" HorizontalAlignment="Right" Margin="3">
                <TextBlock Text = "Цена: " />
                <TextBox Name="FoodPriceTB" Width="200" PreviewTextInput="FoodPriceTb_PreviewTextInput"></TextBox>
            </StackPanel>
            <StackPanel Orientation = "Horizontal" HorizontalAlignment="Center" Margin="3">
                <Button Name = "SaveButton" Click="SaveButton_Click" Content="Сохранить изменения"/>
                <Button Name = "ExitButton" Margin="10 0 0 0" Click="ExitButton_Click" Content="Выйти"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
